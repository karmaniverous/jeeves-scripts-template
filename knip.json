{
  "entry": [
    "src/**/index.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "src/slack/lib/map-helpers.cjs"
  ],
  "project": ["src/**/*"],
  "ignoreDependencies": ["git-cliff"],
  "rules": {
    "exports": "off",
    "types": "off"
  },
  "vitest": {
    "entry": ["src/**/*.test.ts"]
  }
}
